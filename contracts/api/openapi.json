     "puzzleNumber": {
      "type": "integer",
      "title": "Puzzlenumber"
     },
     "release": {
      "$ref": "#/components/schemas/PublicManifest"
     },
     "collectionPolicy": {
      "$ref": "#/components/schemas/CollectionPolicyOut"
     }
