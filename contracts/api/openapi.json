      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "title": "Top3"
     },
     "collectionConsentRevision": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Collectionconsentrevision"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "submissionId",
     "releaseId",
     "modelVersion",
     "preprocessingVersion",
     "catalogVersion",
     "outputCalibrationVersion",
     "drawingVersion",
     "brushVersion",
     "drawingHash",
     "top3",
     "collectionConsentRevision"
    ],
    "title": "SubmissionIn"
   },
   "SubmissionOut": {
    "properties": {
     "requestSubmissionId": {
      "type": "string",
      "format": "uuid",
      "title": "Requestsubmissionid"
