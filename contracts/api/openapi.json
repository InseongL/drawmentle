    "properties": {
     "manifestVersion": {
      "type": "string",
      "const": "release-public-v1",
      "title": "Manifestversion"
     },
     "releaseId": {
      "type": "string",
      "title": "Releaseid"
     },
     "status": {
      "type": "string",
      "enum": [
       "dev-only",
       "production"
