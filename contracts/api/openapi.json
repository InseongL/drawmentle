      "type": "string",
      "title": "Categoryid"
     },
     "candidateIndex": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Candidateindex"
     },
     "displayNameKo": {
      "type": "string",
      "title": "Displaynameko"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "categoryId",
     "candidateIndex",
     "displayNameKo"
    ],
    "title": "Candidate"
   },
