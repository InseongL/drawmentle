    "type": "object",
    "required": [
     "puzzleId",
     "serviceDate",
     "puzzleNumber",
     "release",
     "collectionPolicy"
    ],
    "title": "PuzzleOut"
   },
   "RawClass": {
    "properties": {
     "classIndex": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Classindex"
