     {
      "name": "puzzle_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Puzzle Id"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 50,
       "minimum": 1,
       "default": 10,
       "title": "Limit"
      }
     },
     {
      "name": "beforeAttemptNumber",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
