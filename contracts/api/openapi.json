    "properties": {
     "submissionId": {
      "type": "string",
      "format": "uuid",
      "title": "Submissionid"
     },
     "releaseId": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Releaseid"
     },
     "modelVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Modelversion"
     },
     "preprocessingVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Preprocessingversion"
     },
     "catalogVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Catalogversion"
     },
     "outputCalibrationVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Outputcalibrationversion"
     },
     "drawingVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Drawingversion"
     },
     "brushVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._\\-]+$",
      "title": "Brushversion"
