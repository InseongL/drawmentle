     "brushVersions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "minItems": 1,
      "title": "Brushversions"
     },
     "model": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "inference": {
      "$ref": "#/components/schemas/Inference"
     },
     "rawClasses": {
      "items": {
       "$ref": "#/components/schemas/RawClass"
      },
      "type": "array",
      "title": "Rawclasses"
     },
     "rawClassesSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rawclassessha256"
     },
     "candidates": {
      "items": {
       "$ref": "#/components/schemas/Candidate"
      },
      "type": "array",
      "title": "Candidates"
     },
     "candidatesSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidatessha256"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "manifestVersion",
     "releaseId",
     "status",
     "modelVersion",
     "preprocessingVersion",
     "catalogVersion",
     "outputCalibrationVersion",
     "drawingVersions",
     "brushVersions",
     "model",
     "inference",
     "rawClasses",
     "rawClassesSha256",
     "candidates",
     "candidatesSha256"
    ],
    "title": "PublicManifest",
    "description": "Everything the browser needs to produce a valid Top-3. No answer, thresholds, attributes or score table."
   },
